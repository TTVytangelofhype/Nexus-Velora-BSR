<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net472</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>latest</LangVersion><Nullable>enable</Nullable><AssemblyName>NexusVeloraBSR.BeatSaber</AssemblyName><NexusGameVersion Condition="'$(NexusGameVersion)'==''">unknown</NexusGameVersion><DefineConstants>$(DefineConstants);NEXUS_MULTIVERSION</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(BeatSaberDir)'==''"><BeatSaberDir>$(BEAT_SABER_DIR)</BeatSaberDir></PropertyGroup>
  <PropertyGroup Condition="'$(IpaDll)'==''"><IpaDll>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.dll</IpaDll></PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="PendingRefresh.cs" />
    <Compile Include="NativeRequestDisplay.cs" />
    <EmbeddedResource Include="$(NexusManifestPath)" Condition="'$(NexusManifestPath)' != ''" />
    <EmbeddedResource Include="manifest.json" Condition="'$(NexusManifestPath)' == ''" />
    <Reference Include="System.Net.Http" />
    <Reference Include="IPA"><HintPath>$(IpaDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="SongCore"><HintPath>$(BeatSaberDir)\Plugins\SongCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
